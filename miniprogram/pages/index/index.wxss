.page{padding:28rpx 28rpx 0}.header{display:flex;align-items:center;gap:18rpx;margin:8rpx 0 26rpx}.seal,.mini-seal{background:#9d2428;color:#fff;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-family:serif}.seal{width:72rpx;height:72rpx;font-size:40rpx}.name{font-family:serif;font-size:42rpx;font-weight:700}.by{font-size:18rpx;letter-spacing:3rpx;color:#8b7163}.search{height:78rpx;background:#fffaf2;border:1rpx solid #ddcdb9;border-radius:40rpx;display:flex;align-items:center;padding:0 28rpx;gap:14rpx}.search input{flex:1;font-size:28rpx}.hero{margin:28rpx 0;padding:42rpx 36rpx;border-radius:28rpx;color:#fff;background:linear-gradient(135deg,#6e161a,#b33a31 70%,#d18f47)}.eyebrow{font-size:21rpx;letter-spacing:2rpx;color:#f1d2a6}.headline{font-family:serif;font-size:54rpx;font-weight:700;line-height:1.2;margin:20rpx 0}.headline text{display:block;color:#f4cf87}.daily{font-size:25rpx;opacity:.9}.hero button{margin:30rpx 0 0;width:290rpx;background:#f8e8cc;color:#741a1d;border-radius:36rpx;font-size:26rpx}.section-title{display:flex;justify-content:space-between;align-items:center;font-family:serif;font-size:36rpx;font-weight:700;margin:34rpx 6rpx 18rpx}.count{font-family:sans-serif;font-size:22rpx;color:#9b7d6c;font-weight:400}.list{background:#fffaf3;border-radius:24rpx;padding:6rpx 18rpx}.track{display:flex;align-items:center;min-height:112rpx;border-bottom:1rpx solid #eadfd2}.track:last-child{border:0}.track.active .title,.track.active .num{color:#a32227}.num{width:62rpx;color:#9e887c;text-align:center;font-size:23rpx}.meta{flex:1;min-width:0}.title{font-size:28rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sub{font-size:21rpx;color:#927d70;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.heart{font-size:38rpx;color:#a68e80;padding:20rpx}.heart.saved{color:#ad252a}.player-spacer{height:230rpx}.player{position:fixed;left:0;right:0;bottom:0;background:rgba(255,250,243,.97);border-top:1rpx solid #d8c5b1;padding:18rpx 30rpx 26rpx;z-index:10}.playing{display:flex;align-items:center}.mini-seal{width:58rpx;height:58rpx;margin-right:16rpx}.play-meta{flex:1;font-size:25rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.play-meta text{display:block;color:#90796c;font-size:20rpx}.controls{position:absolute;right:28rpx;top:14rpx;display:flex;align-items:center}.controls button{background:transparent;padding:0;width:64rpx;font-size:42rpx}.controls .main{background:#9d2428;color:white;width:68rpx;height:68rpx;line-height:68rpx;border-radius:50%;font-size:25rpx}.player slider{margin:12rpx 0 0}
.categories{width:100%;white-space:nowrap;margin:2rpx 0 24rpx}.category-row{display:inline-flex;gap:14rpx;padding:2rpx}.category{padding:14rpx 24rpx;border:1rpx solid #d7c4b1;border-radius:30rpx;background:#fffaf3;color:#745f54;font-size:23rpx}.category.selected{background:#96262a;color:#fff;border-color:#96262a}.controls .mode{font-size:27rpx;color:#9d2428}
